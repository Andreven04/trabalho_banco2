# ==========================================================
# Configuração do backend (copie para .env NA RAIZ do projeto)
#   O server.ts carrega o .env desta pasta raiz, NÃO de backend/.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
# ==========================================================

# Porta do backend Fastify
PORT=3000

# Origem liberada no CORS (frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Diretório dos binários do PostgreSQL (pg_dump / psql).
# Windows (ex. PostgreSQL 18): C:\Program Files\PostgreSQL\18\bin
# Linux/macOS: normalmente já no PATH (pode deixar em branco).
PG_BIN=C:\Program Files\PostgreSQL\18\bin

# OBS: a conexão com o banco alvo (host, porta, database, usuário,
# senha, schema, ssl) é informada pelo FORMULÁRIO do frontend — a
# plataforma conecta em qualquer banco (RF01). Não coloque
# credenciais reais aqui nem no repositório.
