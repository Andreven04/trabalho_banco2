# Porta do backend Fastify
PORT=3000

# Origem liberada no CORS (frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Diretório dos binários do PostgreSQL (pg_dump / psql).
# Windows (PostgreSQL 18): C:\Program Files\PostgreSQL\18\bin
# Linux/macOS: normalmente já estão no PATH (pode deixar em branco).
PG_BIN=C:\Program Files\PostgreSQL\18\bin

# OBS: a conexão com o banco é informada pelo formulário do
# frontend (host, porta, database, usuário, senha, schema, ssl) —
# a plataforma conecta em qualquer banco alvo (RF01).
